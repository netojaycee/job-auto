# Database / queue
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_auto
REDIS_URL=redis://localhost:6379

# AI provider — see packages/ai/src/index.ts and ARCHITECTURE.md §8
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Local/offline mode alternative (uncomment to use Ollama instead):
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:14b
# AI_BASE_URL=http://localhost:11434/v1

# File storage (Cloudflare R2 — S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email notifications (digest, alerts — never used to send applications)
RESEND_API_KEY=

# Gmail OAuth (per-user application sending — see ARCHITECTURE.md §5 Tier A)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Auth
AUTH_SECRET=

# Payments (pick one)
STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
