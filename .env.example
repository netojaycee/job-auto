# Local dev only. Points at Postgres/Redis running on your machine (e.g. via
# DBngin) — no Docker needed locally. The production equivalent of this file
# is deploy/.env.example, which targets the docker-compose service names and
# never leaves the server (see ARCHITECTURE.md §11).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_auto
REDIS_URL=redis://localhost:6379

# AI provider — see packages/ai/src/index.ts and ARCHITECTURE.md §8
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Local/offline mode alternative (uncomment to use Ollama instead):
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:14b
# AI_BASE_URL=http://localhost:11434/v1

# File storage (Cloudflare R2 — S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email notifications (digest, alerts — never used to send applications)
RESEND_API_KEY=

# Gmail OAuth (per-user application sending — see ARCHITECTURE.md §5 Tier A)
# GOOGLE_OAUTH_REDIRECT_URI for local dev: http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Safety gate for the apply step — see ARCHITECTURE.md §12. Leave unset
# (dry run: tailors CVs but never emails/submits to a real employer) unless
# you deliberately mean to go live with real applications.
# AGENT_ALLOW_REAL_APPLY=true

# Auth (Better Auth) — generate AUTH_SECRET with: openssl rand -hex 32
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Payments (pick one)
STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
