# Server-side env — lives ONLY on the VPS (via Doppler, a similar secrets
# manager, or hand-created over SSH). Never committed, never pushed by CI.
# CI's deploy step only ever syncs docker-compose.yml + Caddyfile here —
# this file documents what must exist alongside them, it is not itself shipped.

REGISTRY=ghcr.io/your-org
IMAGE_TAG=latest

POSTGRES_USER=jobauto
POSTGRES_PASSWORD=
POSTGRES_DB=job_auto

DATABASE_URL=postgres://jobauto:${POSTGRES_PASSWORD}@postgres:5432/job_auto
REDIS_URL=redis://redis:6379

AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

AUTH_SECRET=
BETTER_AUTH_URL=https://job-auto.yourdomain.com

STRIPE_SECRET_KEY=
