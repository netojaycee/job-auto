{
  "name": "job-auto",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev:web": "pnpm --filter @job-auto/web dev",
    "dev:worker": "pnpm --filter @job-auto/worker start:dev",
    "db:generate": "pnpm --filter @job-auto/db generate",
    "db:migrate": "pnpm --filter @job-auto/db migrate"
  }
}
